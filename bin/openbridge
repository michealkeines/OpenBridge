#!/usr/bin/env python3
"""openbridge — CLI entry-point. Resolves the openbridge package on sys.path
relative to this script's location, so the wrapper works whether OpenBridge
is installed via pip or used directly from a checkout."""
import os
import sys
from pathlib import Path

# When used from a source checkout, ensure the package directory is importable.
_here = Path(__file__).resolve().parent
_repo_root = _here.parent
if (_repo_root / "openbridge" / "__init__.py").exists():
    sys.path.insert(0, str(_repo_root))

from openbridge.cli import main

if __name__ == "__main__":
    sys.exit(main())
